+package net.bagusekasaputra.griyakampoengtkw
+
+import android.app.Service
+import android.content.Intent
+import android.os.Handler
+import android.os.IBinder
+import android.util.Log
+import net.bagusekasaputra.griyakampoengtkw.presentation.util.NotificationUtil
+import java.util.Timer
+import java.util.TimerTask
+
+class NotifTesService: Service() {
+
+    private  var timer: Timer? = null
+    private var timerTask: TimerTask? = null
+    private val TAG = "Timers"
+    private val notificationInSecond = 5L
+
+    override fun onBind(intent: Intent?): IBinder? {
+        return null
+    }
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        Log.e(TAG, "onStartCommand")
+        super.onStartCommand(intent, flags, startId)
+
+        startTimer()
+
+        return START_STICKY
+    }
+
+    override fun onCreate() {
+        Log.e(TAG, "onCreate")
+    }
+
+    override fun onDestroy() {
+        Log.e(TAG, "onDestroy")
+        stopTimerTask()
+        super.onDestroy()
+    }
+
+    private val handler = Handler()
+
+    private fun startTimer() {
+        timer = Timer()
+
+        // Initialize the TimerTask's job
+        initializeTimerTask()
+
+        // Schedule the timer, after first 5000 ms the TimerTask will run
+        // every notificationInSecond * 1000 ms
+        timer?.schedule(timerTask, 5000L, notificationInSecond * 1000)
+
+    }
+
+    private fun stopTimerTask() {
+        // Stop the timer, if it's not already null
+        timer?.cancel()
+        timer = null
+    }
+
+    private fun initializeTimerTask() {
+        timerTask = object : TimerTask() {
+            override fun run() {
+                handler.post {
+                    NotificationUtil.createNotification(
+                        context = this@NotifTesService.applicationContext,
+                        title =  "This is Timer Notification!",
+                        text = "Lorem lorem ipsum amet gaeroh wayah",
+                    )
+                }
+            }
+        }
+    }
+}
