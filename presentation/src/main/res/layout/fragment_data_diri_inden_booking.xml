<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefresh_data_diri"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.indenBooking.DataDiriIndenBookingFragment"
    android:theme="@style/Theme.GriyaKampoengTKW.BlackWhite">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constrain_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view_imageview_and_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraint_foto_and_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/layout_image_and_loading"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_image_profile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/img_profile"
                            android:layout_width="250dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/avatar_1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_loading_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ProgressBar
                            android:id="@+id/progress_bar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            app:layout_constraintBottom_toTopOf="@id/tv_loading_text"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_loading_text"
                            style="@style/TextAppearance.MaterialComponents.Subtitle1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/progress_bar"
                            app:layout_constraintStart_toStartOf="@id/progress_bar"
                            app:layout_constraintTop_toBottomOf="@id/progress_bar"
                            tools:text="Memuat gambar ..."/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </FrameLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_data_diri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="8dp"
                    android:background="@color/primaryColor"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_image_and_loading"
                    app:strokeColor="@color/grey_300"
                    app:strokeWidth="1dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="0dp">


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal"
                            android:paddingVertical="8dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="start"
                                android:text="Nama"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_nama"
                                style="@style/TextAppearance.MaterialComponents.Headline6"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size"
                                tools:text="Zeus bin Chronus bin Gaia" />

                        </androidx.appcompat.widget.LinearLayoutCompat>


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal"
                            android:paddingVertical="8dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="start"
                                android:text="Jenis Identitas"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_jenis_identitas"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size"
                                tools:text="KTP" />

                        </androidx.appcompat.widget.LinearLayoutCompat>


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal"
                            android:paddingVertical="8dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="start"
                                android:text="No. Identitas"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_no_identitas"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size"
                                tools:text="3507043007010001" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="8dp" />
                        <!-- -->
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal"
                            android:paddingVertical="8dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="start"
                                android:text="Negara Bekerja"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_negara_bekerja"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size"
                                tools:text="Hongkong" />

                        </androidx.appcompat.widget.LinearLayoutCompat>


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal"
                            android:paddingVertical="8dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="0.5"
                                android:gravity="center_vertical"
                                android:text="Alamat Kerja"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_alamat_kerja"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size"
                                tools:text="Jl. Rabat Beton No. 21 Harjokuncaran RT.14/05 Sumbermanjing Wetan" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="8dp" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal"
                            android:paddingVertical="8dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="0.5"
                                android:gravity="center_vertical"
                                android:text="Alamat Indo"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_alamat_indo"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size"
                                tools:text="Lorem Ipsum, Dolor Sit 225, AMET CONSECTETUR, Hong Kong" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal"
                            android:paddingVertical="8dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:layout_weight="0.5"
                                android:gravity="start"
                                android:text="No. Hp"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size" />


                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tv_no_hp"
                                    style="@style/TextAppearance.MaterialComponents.Subtitle1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:gravity="end"
                                    android:text="-"
                                    android:textColor="@color/primaryTextColor"
                                    android:textSize="@dimen/data_diri_text_size"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toStartOf="@id/imgInfo_open_whatsapp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    tools:text="+60 1-5578-9987-4" />

                                <ImageView
                                    android:id="@+id/imgInfo_open_whatsapp"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/baseline_open_in_new_24"
                                    app:layout_constraintBottom_toBottomOf="@id/tv_no_hp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="@id/tv_no_hp" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.appcompat.widget.LinearLayoutCompat>


                    </androidx.appcompat.widget.LinearLayoutCompat>

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    app:layout_constraintTop_toBottomOf="@id/card_data_diri"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

