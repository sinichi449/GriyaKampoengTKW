<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_kavling"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="4dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="16dp"
    app:cardBackgroundColor="@color/abang"
    android:checkable="true"
    android:focusable="true"
    android:animateLayoutChanges="true"
    app:checkedIcon="@drawable/ic_baseline_check_circle_18"
    app:checkedIconMargin="-1dp"
    android:theme="@style/Theme.GriyaKampoengTKW.BlackWhite">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@color/abang">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_kavling"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="A2"
            style="@style/TextAppearance.MaterialComponents.Headline5"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:textColor="@color/secondaryTextColor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_namaUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paijo"
            android:textColor="@color/secondaryTextColor"
            style="@style/TextAppearance.Material3.BodyLarge"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_kavling"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
