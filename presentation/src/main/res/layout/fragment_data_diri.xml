<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_refresh_data_diri"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".detail.DataDiriFragment"
    android:theme="@style/Theme.GriyaKampung.BlackWhite">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constrain_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view_imageview_and_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraint_foto_and_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/img_profile"
                    android:layout_width="250dp"
                    android:layout_height="300dp"
                    android:layout_marginTop="24dp"
                    android:src="@drawable/avatar_1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_data_diri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="8dp"
                    android:background="@color/primaryColor"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/img_profile">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="0dp">


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="start"
                                android:text="Nama"
                                android:textSize="@dimen/data_diri_text_size"
                                android:textColor="@color/primaryTextColor"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_nama"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                tools:text="Zeus bin Chronus bin Gaia"
                                android:textSize="@dimen/data_diri_text_size"
                                android:textColor="@color/primaryTextColor"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"/>

                        </androidx.appcompat.widget.LinearLayoutCompat>


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="start"
                                android:text="Jenis Identitas"
                                android:textSize="@dimen/data_diri_text_size"
                                android:textColor="@color/primaryTextColor"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_jenis_identitas"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                tools:text="KTP"
                                android:textColor="@color/primaryTextColor"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"
                                android:textSize="@dimen/data_diri_text_size" />

                        </androidx.appcompat.widget.LinearLayoutCompat>


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="start"
                                android:text="No. Identitas"
                                android:textSize="@dimen/data_diri_text_size"
                                android:textColor="@color/primaryTextColor"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_no_identitas"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                tools:text="3507043007010001"
                                android:textColor="@color/primaryTextColor"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"
                                android:textSize="@dimen/data_diri_text_size" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="8dp"/>
                        <!-- -->
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="start"
                                android:text="Negara Bekerja"
                                android:textSize="@dimen/data_diri_text_size"
                                android:textColor="@color/primaryTextColor" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_negara_bekerja"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                tools:text="Hongkong"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"/>

                        </androidx.appcompat.widget.LinearLayoutCompat>


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="0.5"
                                android:gravity="center_vertical"
                                android:text="Alamat Kerja"
                                android:textSize="@dimen/data_diri_text_size"
                                android:textColor="@color/primaryTextColor"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_alamat_kerja"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                tools:text="Jl. Rabat Beton No. 21 Harjokuncaran RT.14/05 Sumbermanjing Wetan"
                                android:textColor="@color/primaryTextColor"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"
                                android:textSize="@dimen/data_diri_text_size" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="8dp"/>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="0.5"
                                android:gravity="center_vertical"
                                android:text="Alamat Indo"
                                android:textSize="@dimen/data_diri_text_size"
                                android:textColor="@color/primaryTextColor"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_alamat_indo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                tools:text="Lorem Ipsum, Dolor Sit 225, AMET CONSECTETUR, Hong Kong"
                                android:textColor="@color/primaryTextColor"
                                android:textSize="@dimen/data_diri_text_size"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"/>

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="@dimen/data_diri_padding_horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="start"
                                android:text="No. Hp"
                                android:textSize="@dimen/data_diri_text_size"
                                android:textColor="@color/primaryTextColor"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_no_hp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:gravity="end"
                                android:text="-"
                                tools:text="+60 1-5578-9987-4"
                                android:textColor="@color/primaryTextColor"
                                style="@style/TextAppearance.MaterialComponents.Subtitle1"
                                android:textSize="@dimen/data_diri_text_size" />

                        </androidx.appcompat.widget.LinearLayoutCompat>


                    </androidx.appcompat.widget.LinearLayoutCompat>

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    app:layout_constraintTop_toBottomOf="@id/card_data_diri"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            app:icon="@drawable/ic_baseline_add_24"
            android:text="Ubah"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_tambah_data_diri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_baseline_person_24"
            app:layout_constraintBottom_toTopOf="@id/fab_actions"
            app:layout_constraintEnd_toEndOf="@id/fab_actions"
            android:layout_marginBottom="24dp"
            app:fabSize="normal"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_tambah_foto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_baseline_camera_alt_24"
            app:layout_constraintBottom_toTopOf="@id/fab_tambah_data_diri"
            app:layout_constraintEnd_toEndOf="@id/fab_tambah_data_diri"
            android:layout_marginBottom="24dp"
            app:fabSize="normal"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

