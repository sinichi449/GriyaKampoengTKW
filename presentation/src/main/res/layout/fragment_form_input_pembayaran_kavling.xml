<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Form content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jenis Pembayaran"
                style="@style/TextAppearance.MaterialComponents.Subtitle1"/>

            <RadioGroup
                android:id="@+id/rg_jenisPembayaran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_itj"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ITJ"
                    android:theme="@style/Theme.GriyaKampung.Material3"/>

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DP"
                    android:theme="@style/Theme.GriyaKampung.Material3"/>

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_termin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Termin"
                    android:theme="@style/Theme.GriyaKampung.Material3"/>

            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_termin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Silakan pilih jenis pembayaran"
                android:layout_marginTop="8dp"
                android:enabled="false"
                app:startIconDrawable="@drawable/ic_baseline_account_balance_wallet_24"
                app:endIconMode="clear_text"
                style="@style/DenseOutlinedTextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_termin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:enabled="false"
                    android:inputType="number"
                    style="@style/DenseOutlineEditText"/>

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_tanggal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_pilih_tanggal"
                    app:layout_constraintHorizontal_weight="0.75"
                    android:layout_marginEnd="8dp"
                    android:hint="Tanggal"
                    app:startIconDrawable="@drawable/ic_baseline_calendar_month_24"
                    app:endIconMode="clear_text"
                    style="@style/OutlinedTextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_tanggal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        style="@style/OutlineEditText"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pilih_tanggal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/til_tanggal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/til_tanggal"
                    app:layout_constraintBottom_toBottomOf="@id/til_tanggal"
                    app:layout_constraintHorizontal_weight="0.25"
                    android:textSize="12sp"
                    android:textColor="@color/secondaryColor"
                    android:text="Pilih"
                    app:cornerRadius="8dp"
                    style="@style/TextDialogButton"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Jumlah Uang Dibayar"
                android:layout_marginTop="8dp"
                app:startIconDrawable="@drawable/ic_baseline_attach_money_24"
                app:endIconMode="clear_text"
                style="@style/DenseOutlinedTextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_jumlah_uang_dibayar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="number"
                    style="@style/DenseOutlineEditText"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Keterangan Progress"
                android:layout_marginTop="8dp"
                app:startIconDrawable="@drawable/ic_baseline_notes_24"
                app:endIconMode="clear_text"
                style="@style/OutlinedTextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_keterangan_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="textMultiLine"
                    style="@style/OutlineEditText"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Overdue Invoice -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Invoice"
                    style="@style/TextAppearance.MaterialComponents.Headline6"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_pembayaranOverdueInvoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:strokeColor="@color/grey_300"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="8dp"
                    android:focusable="true"
                    android:clickable="true">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_pembayaranUntukBulanSekarang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/checkBox_pembayaranUntukBulanSekarang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/checkBox_pembayaranUntukBulanSekarang"
                            app:layout_constraintTop_toTopOf="@id/checkBox_pembayaranUntukBulanSekarang"
                            app:layout_constraintBottom_toBottomOf="@id/checkBox_pembayaranUntukBulanSekarang"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginHorizontal="16dp"
                            android:text="Pembayaran untuk bulan ini"
                            style="@style/TextAppearance.MaterialComponents.Subtitle2"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_pembayaranUntukCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:layout_margin="16dp">

                        <Spinner
                            android:id="@+id/spinner_bulanAngsuran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <Spinner
                            android:id="@+id/spinner_tahunAngsuran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="@id/spinner_bulanAngsuran"
                            app:layout_constraintBottom_toBottomOf="@id/spinner_bulanAngsuran"
                            app:layout_constraintStart_toEndOf="@id/spinner_bulanAngsuran"
                            android:layout_marginStart="8dp"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

    <!-- Layout Loading -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_loading_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memverifikasi data pembayaran ..."
            android:layout_marginTop="36dp"
            style="@style/TextAppearance.MaterialComponents.Body2"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>