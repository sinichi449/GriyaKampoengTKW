<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/table_generic_double_row_header_width"
    android:layout_height="@dimen/table_generic_cell_height"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_rekap_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.375"/>

    <View
        android:layout_width="@dimen/table_corner_line_weight"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline_rekap_vertical"
        app:layout_constraintEnd_toEndOf="@id/guideline_rekap_vertical"
        android:background="@color/black"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_rh_nomor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_rekap_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="24"
        android:gravity="center"
        android:textSize="@dimen/table_pembayaran_column_header_text_size"
        style="@style/TextAppearance.MaterialComponents.Subtitle1"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_rh_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/guideline_rekap_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:layout_marginHorizontal="8dp"
        android:text="A3"
        android:textStyle="bold"
        android:textSize="@dimen/table_pembayaran_column_header_text_size"
        style="@style/TextAppearance.MaterialComponents.Subtitle1"/>

    <!-- Left -->
    <View
        android:layout_width="@dimen/table_corner_line_weight"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/black"/>

    <!-- Right -->
    <View
        android:layout_width="@dimen/table_corner_line_weight"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/black"/>

</androidx.constraintlayout.widget.ConstraintLayout>