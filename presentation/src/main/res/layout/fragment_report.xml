<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_refresh_report"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".main.fragment.ReportFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_report"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".main.fragment.ReportFragment">

            <!-- Periode Spinner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_periode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:cardElevation="@dimen/report_item_elevation">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_info_pilih_periode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih periode"
                        style="@style/TextAppearance.MaterialComponents.Body2"/>

                    <Spinner
                        android:id="@+id/spinner_periode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:spinnerMode="dropdown"/>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </com.google.android.material.card.MaterialCardView>

            <!-- Rekap Besar -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/linear_layout_rekap_besar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_periode"
                android:elevation="0dp"
                android:padding="@dimen/report_item_padding"
                android:background="#E3F2FD"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rekap Besar"
                    android:textStyle="bold"
                    android:layout_weight="0.5"
                    style="@style/TextAppearance.MaterialComponents.Body2"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_rekap_besar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rp. 130,000,000"
                    android:layout_weight="0.5"
                    android:gravity="end"
                    android:textStyle="bold"
                    style="@style/TextAppearance.MaterialComponents.Body2"/>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Card Total uang masuk -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_total_uang_masuk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linear_layout_rekap_besar"
                android:clickable="true"
                android:focusable="true"
                android:elevation="@dimen/report_item_elevation"
                app:cardBackgroundColor="@color/primaryLightColor">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingVertical="16dp">

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline_vertical_total_uang_masuk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintGuide_percent="0.5"
                            android:orientation="vertical"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_info_rekap_total_uang_masuk"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/guideline_vertical_total_uang_masuk"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/tv_info_rekap_total_uang_masuk_desc"
                            app:layout_constraintVertical_chainStyle="packed"
                            android:text="Total Uang Masuk"
                            style="@style/TextAppearance.MaterialComponents.Subtitle1"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_info_rekap_total_uang_masuk_desc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/guideline_vertical_total_uang_masuk"
                            app:layout_constraintTop_toBottomOf="@id/tv_info_rekap_total_uang_masuk"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginTop="4dp"
                            android:text="Lorem ipsum dolor sit amet"/>


                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_rekap_total_uang_masuk"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/guideline_vertical_total_uang_masuk"
                            app:layout_constraintEnd_toStartOf="@id/img_rekap_arrow_right"
                            app:layout_constraintTop_toTopOf="@id/tv_info_rekap_total_uang_masuk"
                            app:layout_constraintBottom_toBottomOf="@id/tv_info_rekap_total_uang_masuk_desc"
                            android:layout_marginEnd="4dp"
                            android:text="Rp. 80,000,000"
                            android:gravity="end"
                            android:textColor="@color/primaryTextColor"
                            android:textSize="16sp"/>

                        <ImageView
                            android:id="@+id/img_rekap_arrow_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tv_rekap_total_uang_masuk"
                            app:layout_constraintBottom_toBottomOf="@id/tv_rekap_total_uang_masuk"
                            android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
                            android:alpha="0.4"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </com.google.android.material.card.MaterialCardView>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
