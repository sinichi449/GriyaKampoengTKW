<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_refresh_biaya_marketing"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".detail.fragment.BiayaMarketingFragment"
    android:theme="@style/Theme.GriyaKampung.BlackWhite">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constaint_biaya_marketing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="36dp">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_info_title_fee_marketing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="Fee Marketing"
                    style="@style/TextAppearance.MaterialComponents.Headline6"
                    android:textSize="@dimen/form_pembayaran_title_text_size"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_nama_marketer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/tv_info_title_fee_marketing"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guideline_vertical"
                    android:gravity="start"
                    android:layout_marginTop="8dp"
                    android:text="@string/biaya_marketing_tidak_ada_marketer"
                    tools:text="Nuridi"
                    style="@style/TextAppearance.MaterialComponents.Subtitle1"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_biaya_marketer"
                    style="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:text="0"
                    tools:text="4,500,000"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_nama_marketer"
                    app:layout_constraintStart_toEndOf="@+id/tv_nama_marketer"
                    app:layout_constraintTop_toTopOf="@+id/tv_nama_marketer" />


                <ImageView
                    android:id="@+id/img_edit_biaya_marketer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_baseline_edit_24"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_biaya_marketer"
                    app:layout_constraintStart_toEndOf="@+id/tv_biaya_marketer"
                    app:layout_constraintTop_toTopOf="@+id/tv_biaya_marketer"
                    android:layout_marginStart="24dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_tanggal_penerimaan_fee_marketing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guideline_vertical"
                    app:layout_constraintTop_toBottomOf="@id/tv_nama_marketer"
                    android:layout_marginTop="4dp"
                    android:text="-"
                    tools:text="14/09/2022"/>


                <com.evrencoskun.tableview.TableView
                    android:id="@+id/tableview_biaya_marketing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_tanggal_penerimaan_fee_marketing"
                    app:column_header_height="@dimen/table_pembayaran_column_header_height"
                    app:row_header_width="@dimen/default_row_header_width"
                    app:show_horizontal_separator="true"
                    app:show_vertical_separator="true"
                    app:separator_color="@color/black"
                    android:layout_marginTop="24dp"/>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tableview_biaya_marketing"
                    android:layout_marginTop="24dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_info_total_biaya"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Total Biaya"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    app:layout_constraintEnd_toStartOf="@id/guideline_vertical"
                    style="@style/TextAppearance.MaterialComponents.Headline6"
                    android:textSize="@dimen/form_pembayaran_title_text_size"
                    android:layout_marginTop="16dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_total_biaya"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/guideline_vertical"
                    app:layout_constraintTop_toTopOf="@id/tv_info_total_biaya"
                    app:layout_constraintBottom_toBottomOf="@id/tv_info_total_biaya"
                    android:layout_marginStart="40dp"
                    style="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:text="0" />


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_info_cuan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Cuan"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_info_total_biaya"
                    app:layout_constraintEnd_toStartOf="@id/guideline_vertical"
                    style="@style/TextAppearance.MaterialComponents.Headline6"
                    android:textSize="@dimen/form_pembayaran_title_text_size"
                    android:layout_marginTop="8dp"/>


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_cuan"
                    style="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_info_cuan"
                    app:layout_constraintStart_toStartOf="@+id/tv_total_biaya"
                    app:layout_constraintTop_toTopOf="@+id/tv_info_cuan" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_actions_biaya_marketing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:text="Ubah"
            app:icon="@drawable/ic_baseline_add_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_tambah_biaya_marketing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/fab_actions_biaya_marketing"
            app:layout_constraintBottom_toTopOf="@id/fab_actions_biaya_marketing"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_baseline_create_new_folder_24"
            android:contentDescription="Tambah Biaya Marketing"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_edit_biaya_marketing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/fab_tambah_biaya_marketing"
            app:layout_constraintBottom_toTopOf="@id/fab_tambah_biaya_marketing"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_baseline_edit_24"
            android:contentDescription="Edit Biaya Marketing"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>