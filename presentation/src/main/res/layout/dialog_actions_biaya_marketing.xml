<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="24dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_info_title_tambah_biaya_marketing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Tambah Biaya Marketing"
        style="@style/TextAppearance.MaterialComponents.Headline6" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_jenis_biaya"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_info_title_tambah_biaya_marketing"
        android:layout_marginTop="24dp"
        app:startIconDrawable="@drawable/ic_baseline_add_card_24"
        app:endIconMode="clear_text"
        android:hint="Jenis Biaya"
        style="@style/OutlinedTextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_jenis_biaya"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="textMultiLine"
            android:maxLength="50"
            style="@style/OutlineEditText"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_harga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_jenis_biaya"
        android:layout_marginTop="8dp"
        app:startIconDrawable="@drawable/ic_baseline_attach_money_24"
        android:hint="Harga"
        app:endIconMode="clear_text"
        style="@style/DenseOutlinedTextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_harga"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="number"
            style="@style/DenseOutlineEditText"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_tanggal_biaya_marketing"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_pilih_tanggal_biaya_marketing"
        app:layout_constraintTop_toBottomOf="@id/til_harga"
        android:layout_marginTop="8dp"
        android:hint="Tanggal"
        app:startIconDrawable="@drawable/ic_baseline_calendar_month_24"
        app:endIconMode="clear_text"
        style="@style/DenseOutlinedTextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_tanggal_biaya_marketing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="date"
            style="@style/DenseOutlineEditText"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pilih_tanggal_biaya_marketing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/til_tanggal_biaya_marketing"
        app:layout_constraintBottom_toBottomOf="@id/til_tanggal_biaya_marketing"
        android:text="Pilih"
        android:textColor="@color/secondaryColor"
        style="@style/TextDialogButton"/>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_tambahkan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/til_tanggal_biaya_marketing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:text="Tambahkan"
        app:cornerRadius="8dp"
        style="@style/NormalDialogButton"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_batal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_tambahkan"
        android:text="Batal"
        app:cornerRadius="8dp"
        style="@style/NormalDialogButton"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_hapus_biaya_marketing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/btn_batal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        app:cornerRadius="8dp"
        android:textColor="@color/abang"
        android:text="Hapus Biaya Marketing"
        android:visibility="gone"
        style="@style/TextDialogButton"/>

</androidx.constraintlayout.widget.ConstraintLayout>