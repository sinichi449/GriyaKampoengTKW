<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_refresh_main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.management.KavlingFragment"
    android:theme="@style/Theme.GriyaKampoengTKW.BlackWhite"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="56dp">

            <ImageView
                android:id="@+id/img_icon_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_block_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp"
                app:tint="@color/primaryTextColor" />


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_info_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Blocks"
                app:layout_constraintStart_toEndOf="@id/img_icon_block"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/img_icon_block"
                app:layout_constraintBottom_toBottomOf="@id/img_icon_block"
                android:layout_marginStart="8dp"
                style="@style/TextAppearance.MaterialComponents.Headline6"
                android:textColor="@color/primaryTextColor"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_blocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_info_block"
                android:elevation="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="16dp"
                android:paddingHorizontal="8dp"
                android:clipToPadding="false"/>

            <ImageView
                android:id="@+id/img_icon_kavling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_kavling_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/recycler_blocks"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                app:tint="@color/primaryTextColor"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_info_kavling"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Kavlings"
                app:layout_constraintStart_toEndOf="@id/img_icon_kavling"
                app:layout_constraintTop_toTopOf="@id/img_icon_kavling"
                app:layout_constraintBottom_toBottomOf="@id/img_icon_kavling"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/TextAppearance.MaterialComponents.Headline6"
                android:layout_marginStart="8dp"
                android:textColor="@color/primaryTextColor"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_kavlings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_info_kavling"
                android:clipToPadding="false"
                android:layout_marginVertical="16dp"
                android:layout_marginHorizontal="8dp"
                android:paddingHorizontal="8dp"
                android:elevation="6dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>