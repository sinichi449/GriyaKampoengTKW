<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_root_pengingat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:strokeColor="@color/grey_300"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/white"
        android:focusable="true"
        android:clickable="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_item_pengingat_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <ImageView
                android:id="@+id/img_notification_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:src="@drawable/ic_baseline_notifications_active_48"
                app:tint="@color/primaryTextColor"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_title_pengingat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/img_notification_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/img_notification_icon"
                android:layout_marginStart="16dp"
                android:text="-"
                tools:text="Bayar angsuran kavling A26"
                android:textSize="14sp"
                android:textColor="@color/primaryTextColor"
                style="@style/TextAppearance.MaterialComponents.Headline6"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_date_pengingat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/tv_title_pengingat"
                app:layout_constraintTop_toBottomOf="@id/tv_title_pengingat"
                app:layout_constraintBottom_toBottomOf="@id/img_notification_icon"
                android:text="01/01/1970"
                android:textSize="14sp"
                android:textColor="@color/primaryTextColor"
                style="@style/TextAppearance.MaterialComponents.Subtitle1"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_time_pengingat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/tv_date_pengingat"
                app:layout_constraintTop_toTopOf="@id/tv_date_pengingat"
                app:layout_constraintBottom_toBottomOf="@id/tv_date_pengingat"
                android:layout_marginStart="16dp"
                android:text="00:00"
                android:textSize="14sp"
                android:textColor="@color/primaryTextColor"
                style="@style/TextAppearance.MaterialComponents.Subtitle1"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>