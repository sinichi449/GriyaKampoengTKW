<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_kavling"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    android:elevation="12dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="16dp"
    app:cardBackgroundColor="@color/abang"
    app:cardElevation="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/img_sudah_isi_data_diri"
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="@color/black"
            app:cardCornerRadius="200dp"
            app:cardElevation="64dp"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_card_block_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="A2"
            style="@style/TextAppearance.MaterialComponents.Headline5"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:textColor="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_ukuran"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="6x11"
            android:textColor="@color/white"
            style="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_card_block_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_type_rumah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Type 36"
            android:gravity="center"
            android:textColor="@color/white"
            android:paddingBottom="8dp"
            android:textStyle="italic"
            app:layout_constraintTop_toBottomOf="@id/tv_ukuran"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/img_sudah_isi_data_diri"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>