<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="8dp">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih Tahapan"
        android:layout_margin="16dp"
        style="@style/TextAppearance.MaterialComponents.Headline6"/>

    <!-- Loading Tahapan Layout -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/layout_loading_tahapan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sedang memuat ..."
            style="@style/TextAppearance.MaterialComponents.Body1"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- Recycler Tahapan and Empty State -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/layout_pilih_tahapan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView_tahapan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_tidak_ada_tahapan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tidak ada tahapan pembangunan yang bisa dipilih!"
            android:layout_marginHorizontal="32dp"
            android:gravity="center"
            style="@style/TextAppearance.MaterialComponents.Body2"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- Failure layout -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/layout_failure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_failure_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terjadi kesalahan : Unknown error!"
            style="@style/TextAppearance.MaterialComponents.Body1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_keluar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Keluar"
            app:cornerRadius="8dp"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp"/>

</androidx.appcompat.widget.LinearLayoutCompat>